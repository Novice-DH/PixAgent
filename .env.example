# AI 修图智能体（PixAgent）环境配置模板
# 复制为 .env 后按需修改；.env 不入库，配置唯一来源是它。

# 运行环境标识
APP_ENV=development
# 后端端口
API_PORT=7302

# PostgreSQL（异步驱动 asyncpg）
DATABASE_URL=postgresql+asyncpg://retouch:retouch_dev@localhost:7311/retouch
# Redis（队列与缓存）
REDIS_URL=redis://localhost:7312

# 对象存储（MinIO，兼容 S3）
S3_ENDPOINT=http://localhost:7313
S3_ACCESS_KEY=retouch
S3_SECRET_KEY=retouch_dev
S3_BUCKET=retouch
# 签名 URL 有效期（秒）
S3_URL_TTL=900

# JWT（开发占位值长度不短于 32 字节；生产环境必须替换为随机值）
JWT_SECRET=dev-only-change-me-dev-only-change-me
JWT_TTL_HOURS=24

# 生图 Provider 抽象开关：mock（本地占位图，零费用）| dashscope（百炼）
IMAGE_PROVIDER=mock
# 接真实模型时填写
DASHSCOPE_API_KEY=

# 模型约定：文生图 / 图片编辑 / Agent 规划
TEXT_TO_IMAGE_MODEL=qwen-image-3.0-pro
IMAGE_EDIT_MODEL=qwen-image-edit-max
PLANNER_MODEL=qwen-plus
